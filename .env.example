# =====================================================================
# AfriPulse environment configuration (TEMPLATE)
# Copy this file to .env and fill in real values:
#     cp .env.example .env
# NEVER commit .env. It is listed in .gitignore.
# =====================================================================

# Runtime environment: dev | test | prod
AFRIPULSE_ENV=dev

# PostgreSQL connection for the ingestion pipeline (role: afripulse_app)
AFRIPULSE_DB_HOST=localhost
AFRIPULSE_DB_PORT=5432
AFRIPULSE_DB_NAME=afripulse
AFRIPULSE_DB_USER=afripulse_app
AFRIPULSE_DB_PASSWORD=change_me